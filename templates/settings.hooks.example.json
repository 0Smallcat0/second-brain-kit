{
  "_comment": "Manual install only (not needed when you installed the plugin). Merge the \"hooks\" block into ~/.claude/settings.json and replace __KIT__ with the folder where the hook files were copied, for example /home/me/.claude/sbk/hooks. The sh wrapper picks python3, python or py.",
  "hooks": {
    "SessionStart": [
      {"matcher": "compact", "hooks": [{"type": "command", "command": "sh \"__KIT__/run.sh\" requests_reinject.py", "timeout": 10}]},
      {"matcher": "startup|resume", "hooks": [{"type": "command", "command": "sh \"__KIT__/run.sh\" inbox_notice.py", "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [
        {"type": "command", "command": "sh \"__KIT__/run.sh\" usage_warn.py", "timeout": 10},
        {"type": "command", "command": "sh \"__KIT__/run.sh\" inbox_notice.py", "timeout": 10}
      ]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "sh \"__KIT__/run.sh\" read_whole.py", "timeout": 10},
        {"type": "command", "command": "sh \"__KIT__/run.sh\" vault_guard.py", "timeout": 10}
      ]},
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        {"type": "command", "command": "sh \"__KIT__/run.sh\" vault_guard.py", "timeout": 10}
      ]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "sh \"__KIT__/run.sh\" stop_evidence.py", "timeout": 15}]}
    ]
  }
}
